@page "/"

<PageTitle>Cagnotte Solidaire - Accueil</PageTitle>

<div class="container mt-5">
    <div class="text-center mb-5">
        <h1 class="display-4">🎯 Cagnotte Solidaire</h1>
        <p class="lead">Plateforme de financement participatif pour les associations du Haut-Rhin</p>
    </div>

    <div class="row mt-5">
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-body text-center">
                    <h2 class="card-title">💰 Participer</h2>
                    <p class="card-text">
                        Soutenez les projets d'associations locales en participant à leurs cagnottes.
                    </p>
                    <a href="/register-participant" class="btn btn-primary">S'inscrire comme Participant</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-body text-center">
                    <h2 class="card-title">🏢 Gestionnaire</h2>
                    <p class="card-text">
                        Vous êtes une association ? Créez vos cagnottes pour financer vos projets.
                    </p>
                    <a href="/register-gestionnaire" class="btn btn-success">S'inscrire comme Gestionnaire</a>
                </div>
            </div>
        </div>
    </div>

    <div class="text-center mt-5">
        <p>Déjà inscrit ?</p>
        <a href="/login" class="btn btn-outline-secondary">Se connecter</a>
    </div>
</div>

